# Provider: auto | local | mock | custom | jev
# auto = local heuristic, no agent required. Uses JEV + gateway only if both are set.
JEV_PROVIDER=auto

# JEV decision API (required for provider=jev)
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=jev-latest

# User AI gateway, OpenAI-compatible (required for provider=jev)
# One key + many models (OpenRouter) or several provider keys.
# Examples: https://openrouter.ai/api/v1  https://api.openai.com/v1
GATEWAY_BASE_URL=https://openrouter.ai/api/v1
GATEWAY_API_KEY=
GATEWAY_MODEL=
GATEWAY_MODELS=

# Multi-LLM catalog (optional). Keys stay in env, never in HTTP/MCP bodies.
# JEV_MODELS_FILE=models.json
# JEV_LLM_DEFAULT=openrouter:anthropic/claude-sonnet-4
# JEV_LLM_STRATEGY=named
# JEV_LLM_PROVIDERS=openrouter,openai,groq
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# MISTRAL_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# JEV_LLM_OPENROUTER_MODELS=anthropic/claude-sonnet-4,openai/gpt-4.1-mini
# JEV_LLM_OPENAI_MODELS=gpt-4.1,gpt-4.1-mini

# Router
JEV_AGENT_MIN_CONFIDENCE=0.15
JEV_AGENT_MAX_ALTERNATIVES=3
JEV_AGENT_MAX_CANDIDATES=50

# Security
JEV_REDACT_SECRETS=true
JEV_AGENT_AUTH_TOKEN=

# Server
JEV_AGENT_HOST=127.0.0.1
JEV_AGENT_PORT=8080
