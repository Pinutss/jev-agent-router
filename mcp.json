{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "jev-agent": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${PLUGIN_ROOT}",
        "jev-agent",
        "mcp"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "JEV_PROVIDER": "local"
      }
    }
  }
}
